# ── Client (bundled, public) ──────────────────────────────
# Contact endpoint; defaults to /api/contact (Vercel function in /api).
VITE_CONTACT_ENDPOINT=/api/contact

# ── Server only (set in hosting dashboard, never prefix with VITE_) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: only accept form posts from this origin
CONTACT_ALLOWED_ORIGIN=

# Optional HTTP Basic Auth for the whole site (edge middleware)
SITE_USER=
SITE_PASSWORD=
